# Railway 上传清单：只带站点运行必需的文件
# 注意：这里一旦存在，就会替代 .gitignore 生效，所以本地密钥/缓存都要显式排除

# 本地密钥
.env.local
.dev.vars

# 依赖、版本库、工具缓存
/node_modules/
/.git/
/.wrangler/
/.screenshots/
/.trae/
/.trae-html-share-packages/

# 运行时产物
/logs/
/data/paintings/
/data/tts/
/runtime/

# 开发期脚本与测试
/scripts/
/tests/

# Cloudflare 备用方案（与 Railway 无关）
/functions/
/wrangler.toml
/.assetsignore

# 史料语料必须上传：AI 引文与四库对照依赖它（体积较大，但属于运行数据）
!data/
!data/history/
!data/history/**
