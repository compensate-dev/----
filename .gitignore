# Trae 预览/分享 HTML 时自动生成的打包缓存，不纳入版本管理
.trae-html-share-packages/
# Trae 截图/临时输出目录，同样属于工具缓存
.screenshots/

# 本地密钥：只留在本机，绝不进仓库
.env.local

# 运行时产物：问答日志与词意画/朗读缓存（画一次、读一次就存一份，属于本机缓存）
logs/
data/paintings/
data/tts/

# 史料语料产物：全部可由脚本重建，不进仓库
# （sync-history.mjs 抓全文 → build-history-embeddings.mjs 补向量；
#   vectors.json 102MB，超过 GitHub 100MB 硬限制，git add 会卡死在哈希大文件上）
data/history/

# 比赛下载包附带的便携 Node，不纳入版本管理
runtime/
