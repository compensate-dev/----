# .env.local 已被 git 忽略。

# 对话模型，走 OpenAI 兼容接口
GUIDE_API_KEY=
GUIDE_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 想换模型只改这一行，比如 glm-4-flash
GUIDE_MODEL=deepseek-chat

# 向量模型。不填也能跑，只是检索会退化成关键词匹配
EMBED_API_KEY=
EMBED_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 下面的都可以不填
# Agent 最多调几轮工具，范围 2-5
AGENT_ROUNDS=4
# 填 glm 就优先用 GLM-TTS 朗读，留空则走本机/浏览器语音
TTS_PROVIDER=
# 本地监听端口；上云后平台会自己注入 PORT
PORT=53422
